+/// Parses `RRGGBB` / `RRGGBBAA` (optional leading `#`) into an editor colour. Kept outside the command module because
+/// every function inside it becomes a JS command.
+pub(crate) fn parse_hex_color(hex: &str) -> Option<graphene_std::Color> {
+	let hex = hex.trim().trim_start_matches('#');
+	if hex.len() != 6 && hex.len() != 8 {
+		return None;
+	}
+	let channel = |i: usize| u8::from_str_radix(&hex[i..i + 2], 16).ok();
+	let (red, green, blue) = (channel(0)?, channel(2)?, channel(4)?);
+	let alpha = if hex.len() == 8 { channel(6)? } else { 255 };
+	Some(graphene_std::Color::from(graphene_std::raster::color::SRGBA8::new(red, green, blue, alpha)))
+}
