{
  "name": "graphite-art-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP connector for the Graphite graphics editor (graphite.art): typed editing commands for Claude and other MCP clients",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACoci86/graphite-art-mcp.git"
  },
  "homepage": "https://github.com/ACoci86/graphite-art-mcp#readme",
  "bugs": "https://github.com/ACoci86/graphite-art-mcp/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "graphite-art-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "fonts",
    "graphite-patch",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "e2e": "node e2e/run.mjs",
    "extension": "npm run build && node scripts/build-extension.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "graphite",
    "graphite.art",
    "vector-graphics",
    "svg",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xmldom/xmldom": "^0.9.12",
    "opentype.js": "^1.3.4",
    "tar": "^7.5.22",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/ws": "^8.18.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
